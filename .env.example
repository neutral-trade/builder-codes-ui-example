# NEXT_PUBLIC values are bundled into browser JavaScript and must never contain secrets.

# Solana cluster: mainnet or devnet. Defaults to mainnet.
NEXT_PUBLIC_CLUSTER=mainnet

# Neutral Autopilot bundle address. Defaults to the mainnet address below.
NEXT_PUBLIC_VAULT_ADDRESS=J7qhMAKnB6G5dvoAN9281ufabajKbyGQxxd2bq6R7fPJ

# Builder wallet address. Set exactly one attribution option.
NEXT_PUBLIC_BUILDER_ADDRESS=

# Builder code. Set this instead of NEXT_PUBLIC_BUILDER_ADDRESS.
NEXT_PUBLIC_BUILDER_CODE=

# Browser-safe Solana RPC endpoint. Required because public endpoints rate-limit.
NEXT_PUBLIC_RPC_URL=

# Optional browser API override for client-side integration flows.
NEXT_PUBLIC_NEUTRAL_API_URL=

# Server-only partner API settings. Never add NEXT_PUBLIC_ to the key.
NEUTRAL_API_KEY=

# Optional server-only API override. Defaults to the API for NEXT_PUBLIC_CLUSTER.
NEUTRAL_API_URL=
