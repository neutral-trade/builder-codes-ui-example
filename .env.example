# NEXT_PUBLIC values are compiled into browser JavaScript and must never contain secrets.

# Browser: Solana cluster, mainnet or devnet. Defaults to mainnet.
NEXT_PUBLIC_CLUSTER=mainnet

# Browser: registry vault for the selected cluster. Defaults to mainnet Autopilot.
NEXT_PUBLIC_VAULT_ADDRESS=J7qhMAKnB6G5dvoAN9281ufabajKbyGQxxd2bq6R7fPJ

# Browser: registered builder wallet (Builder ID). Set exactly one attribution option.
NEXT_PUBLIC_BUILDER_ADDRESS=

# Browser: public builder code. Set this instead of NEXT_PUBLIC_BUILDER_ADDRESS.
NEXT_PUBLIC_BUILDER_CODE=

# Browser: browser-safe Solana RPC. Required by this all-flows example.
NEXT_PUBLIC_RPC_URL=

# Browser: optional transaction-builder and code-resolver API override.
# Defaults to the public Neutral API for NEXT_PUBLIC_CLUSTER.
NEXT_PUBLIC_NEUTRAL_API_URL=

# Server only: partner key used by the vault and position data proxy.
# Never add NEXT_PUBLIC_ to this name or expose the value in logs.
NEUTRAL_API_KEY=

# Server only: optional data API override for the proxy.
# Defaults to the Neutral API for NEXT_PUBLIC_CLUSTER.
NEUTRAL_API_URL=
